<?xml version="1.0"?>
<!--
  SO-101 arm + Gripper Forge compliant fingers.

  This is a self-contained kinematic model of the SO-101 arm (shoulder_pan,
  shoulder_lift, elbow_flex, wrist_flex, wrist_roll, gripper) whose finger
  meshes are the compliant fingers exported by Gripper Forge.

  Notes
  - The arm LINK DIMENSIONS in this file are APPROXIMATE (see README). The
    official SO-101 URDF lives in a gated repository; run inject_gripper_forge.py
    on the official file to get an exact model with the same fingers.
  - The two finger links carry the real Gripper Forge geometry:
      meshes/so101_finger_universal.stl
    The left finger is a 180deg turn of the export, the right finger a mirror,
    so the two contact faces point at each other across the grasp axis.
  - Joints are named to match the SO-101 control conventions.
-->
<robot name="so101_gripper_forge">

  <material name="base"><color rgba="0.35 0.38 0.42 1"/></material>
  <material name="arm"><color rgba="0.45 0.47 0.50 1"/></material>
  <material name="mount"><color rgba="0.2 0.55 0.5 1"/></material>
  <material name="tpu_left"><color rgba="0.96 0.58 0.09 1"/></material>
  <material name="tpu_right"><color rgba="0.1 0.6 0.62 1"/></material>

  <!-- ============================ base + arm ============================ -->

  <link name="base_link">
    <inertial>
      <mass value="0.45"/>
      <inertia ixx="0.0009" ixy="0" ixz="0" iyy="0.0009" iyz="0" izz="0.0004"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.022" length="0.030"/></geometry>
      <material name="base"><color rgba="0.35 0.38 0.42 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.022" length="0.030"/></geometry>
    </collision>
  </link>

  <joint name="shoulder_pan" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder"/>
    <origin xyz="0 0 0.030" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="1.5" velocity="2.0"/>
  </joint>

  <link name="shoulder">
    <inertial>
      <mass value="0.12"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry><box size="0.030 0.040 0.030"/></geometry>
      <material name="arm"><color rgba="0.45 0.47 0.5 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.030 0.040 0.030"/></geometry>
    </collision>
  </link>

  <joint name="shoulder_lift" type="revolute">
    <parent link="shoulder"/>
    <child link="upper_arm"/>
    <origin xyz="0.0 0 0.012" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.1" upper="2.1" effort="1.5" velocity="2.0"/>
  </joint>

  <link name="upper_arm">
    <inertial>
      <mass value="0.20"/>
      <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry><box size="0.098 0.030 0.030"/></geometry>
      <origin xyz="0.049 0 0" rpy="0 0 0"/>
      <material name="arm"/>
    </visual>
    <collision>
      <geometry><box size="0.098 0.030 0.030"/></geometry>
      <origin xyz="0.049 0 0" rpy="0 0 0"/>
    </collision>
  </link>

  <joint name="elbow_flex" type="revolute">
    <parent link="upper_arm"/>
    <child link="forearm"/>
    <origin xyz="0.098 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.4" upper="2.4" effort="1.5" velocity="2.0"/>
  </joint>

  <link name="forearm">
    <inertial>
      <mass value="0.18"/>
      <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry><box size="0.102 0.026 0.026"/></geometry>
      <origin xyz="0.051 0 0" rpy="0 0 0"/>
      <material name="arm"/>
    </visual>
    <collision>
      <geometry><box size="0.102 0.026 0.026"/></geometry>
      <origin xyz="0.051 0 0" rpy="0 0 0"/>
    </collision>
  </link>

  <joint name="wrist_flex" type="revolute">
    <parent link="forearm"/>
    <child link="wrist"/>
    <origin xyz="0.102 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.9" upper="1.9" effort="1.0" velocity="2.0"/>
  </joint>

  <link name="wrist">
    <inertial>
      <mass value="0.08"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.00005"/>
    </inertial>
    <visual>
      <geometry><box size="0.044 0.024 0.024"/></geometry>
      <origin xyz="0.022 0 0" rpy="0 0 0"/>
      <material name="arm"/>
    </visual>
    <collision>
      <geometry><box size="0.044 0.024 0.024"/></geometry>
      <origin xyz="0.022 0 0" rpy="0 0 0"/>
    </collision>
  </link>

  <joint name="wrist_roll" type="revolute">
    <parent link="wrist"/>
    <child link="wrist_roll"/>
    <origin xyz="0.044 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="1.0" velocity="2.0"/>
  </joint>

  <link name="wrist_roll">
    <inertial>
      <mass value="0.06"/>
      <inertia ixx="0.00006" ixy="0" ixz="0" iyy="0.00006" iyz="0" izz="0.00006"/>
    </inertial>
    <visual>
      <geometry><box size="0.024 0.024 0.024"/></geometry>
      <material name="arm"/>
    </visual>
    <collision>
      <geometry><box size="0.024 0.024 0.024"/></geometry>
    </collision>
  </link>

  <!-- ============================ gripper ============================ -->

  <!-- The gripper mount bolts to the wrist roll. The fingers mount on its
       face at x = GRIP_X. -->
  <link name="gripper_mount">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00004" ixy="0" ixz="0" iyy="0.00004" iyz="0" izz="0.00004"/>
    </inertial>
    <visual>
      <geometry><box size="0.020 0.032 0.032"/></geometry>
      <origin xyz="0.010 0 0" rpy="0 0 0"/>
      <material name="mount"><color rgba="0.2 0.55 0.5 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.020 0.032 0.032"/></geometry>
      <origin xyz="0.010 0 0" rpy="0 0 0"/>
    </collision>
  </link>

  <joint name="gripper_mount_joint" type="fixed">
    <parent link="wrist_roll"/>
    <child link="gripper_mount"/>
    <origin xyz="0.012 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Left finger. Positive gripper joint value opens the jaw (moves +y). -->
  <link name="gripper_left_finger">
    <inertial>
      <mass value="0.012"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00001"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="meshes/so101_finger_universal.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <!-- The export is in the mount frame (base +x, tip -x, contact +y).
           Turn it 180deg so the tip points forward (+x) and the contact face
           points toward the grasp axis (-y). -->
      <origin xyz="0.0095 0 0" rpy="0 0 3.141592653589793"/>
      <material name="tpu_left"><color rgba="0.96 0.58 0.09 1"/></material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="meshes/so101_finger_universal.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin xyz="0.0095 0 0" rpy="0 0 3.141592653589793"/>
    </collision>
  </link>

  <joint name="gripper" type="prismatic">
    <parent link="gripper_mount"/>
    <child link="gripper_left_finger"/>
    <origin xyz="0.020 0.0099 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="0.020" effort="2.0" velocity="0.5"/>
  </joint>

  <!-- Right finger. Mirrored geometry; mimics the gripper joint in reverse so
       the two jaws open and close symmetrically. -->
  <link name="gripper_right_finger">
    <inertial>
      <mass value="0.012"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00001"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="meshes/so101_finger_universal_right.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin xyz="0.0095 0 0" rpy="0 0 0"/>
      <material name="tpu_right"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="meshes/so101_finger_universal_right.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin xyz="0.0095 0 0" rpy="0 0 0"/>
    </collision>
  </link>

  <joint name="gripper_right" type="prismatic">
    <parent link="gripper_mount"/>
    <child link="gripper_right_finger"/>
    <origin xyz="0.020 -0.0099 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <mimic joint="gripper" multiplier="-1" offset="0"/>
    <limit lower="0" upper="0.020" effort="2.0" velocity="0.5"/>
  </joint>

</robot>
